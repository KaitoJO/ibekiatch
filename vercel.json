{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/cron/monitor.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/stripe/webhook.js": {
      "maxDuration": 30
    }
  }
}
