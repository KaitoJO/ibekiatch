# Supabase（ダッシュボード → Project Settings → API）
#
# ■ VITE_SUPABASE_URL
#   「Project URL」をそのままコピー（例: https://abcdefgh.supabase.co）
#   × 付けてはいけない: /rest/v1/  /auth/v1/  末尾の /
#
# ■ VITE_SUPABASE_ANON_KEY
#   「Project API keys」の anon / public キー、または Publishable key
#   例: eyJhbGciOiJIUzI1NiIs...  または  sb_publishable_...
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase CLI（npm run db:push 用）
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=your-database-password

# Resend SMTP（npm run auth:smtp 用 — 確認メール配信）
# https://resend.com/api-keys で取得
RESEND_API_KEY=re_...
# テスト: onboarding@resend.dev（Resend 登録メアド宛のみ）
# 本番: verify 済みドメインの noreply@yourdomain.com
RESEND_SENDER_EMAIL=onboarding@resend.dev
# フロントの登録画面警告用（RESEND_SENDER_EMAIL と同じ値）
VITE_RESEND_SENDER_EMAIL=onboarding@resend.dev
# false = 確認メールなしで即ログイン（npm run auth:no-confirm 後）
VITE_AUTH_REQUIRE_EMAIL_CONFIRM=false

# テスト期間のみ: ログイン画面を出さず共有アカウントで自動サインイン
# 終了したら false に戻すか変数を削除（パスワードはビルドに含まれるためテスト専用アカウントを使う）
# VITE_AUTH_DISABLED=true
# VITE_TEST_LOGIN_EMAIL=test@example.com
# VITE_TEST_LOGIN_PASSWORD=your-test-password

# テスト担当者メール（カンマ区切り可）— 該当ユーザーのみ AI 収集を全件・終了済み含めて表示
# VITE_MONITOR_TEST_EMAILS=you@example.com

# 監視 API 認証トークン（cron-job.org → /api/cron/monitor）
# ランダムな長い文字列を生成して Vercel 環境変数に設定
MONITOR_CRON_TOKEN=your-random-secret-string

# 監視ジョブ AI 判定（npm run monitor 用）
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# 監視ジョブ（npm run monitor 用 — service_role キー）
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 任意: SNS API ソース
# TWITTER_BEARER_TOKEN=
# META_ACCESS_TOKEN=
# FACEBOOK_PAGE_IDS=123456789,987654321

# Stripe 課金（npm run stripe:setup）
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PREMIUM=price_...
APP_URL=https://ibekiatch.vercel.app
