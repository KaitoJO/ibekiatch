# Supabase（ダッシュボード → Project Settings → API）
#
# ■ VITE_SUPABASE_URL
#   「Project URL」をそのままコピー（例: https://abcdefgh.supabase.co）
#   × 付けてはいけない: /rest/v1/  /auth/v1/  末尾の /
#
# ■ VITE_SUPABASE_ANON_KEY
#   「Project API keys」の anon / public キー、または Publishable key
#   例: eyJhbGciOiJIUzI1NiIs...  または  sb_publishable_...
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase CLI（npm run db:push 用）
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=your-database-password
